# ==============================================================================
# Buffer API Configuration
# ==============================================================================
# Get your access token from Buffer Developer Portal: https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# (Optional) Target LinkedIn Profile ID. If left empty, the pipeline will auto-detect your LinkedIn profile.
# Run `uv run python main.py list-profiles` to view all connected profile IDs.
BUFFER_PROFILE_ID=

# ==============================================================================
# Active LLM Provider Selection
# Options: "gemini" | "fireworks" | "qwen" | "openai_compatible"
# ==============================================================================
ACTIVE_LLM_PROVIDER=gemini

# (Optional) Custom Model override (if left empty, provider defaults in configs/config.yaml will be used)
LLM_MODEL=

# ==============================================================================
# LLM Provider API Keys
# ==============================================================================
# 1. Google Gemini (Get key: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Fireworks AI (Get key: https://fireworks.ai/)
FIREWORKS_API_KEY=your_fireworks_api_key_here

# 3. Qwen / Alibaba DashScope (Get key: https://dashscope.console.aliyun.com/)
DASHSCOPE_API_KEY=your_dashscope_or_qwen_api_key_here
QWEN_API_KEY=
# Custom Qwen base URL (e.g. for Qwen Token Plan: https://token-plan.maas.qwencloudapi.com/compatible-mode/v1)
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1

# 4. Generic OpenAI-Compatible Provider (e.g., OpenRouter, Groq, Ollama, DeepSeek)
OPENAI_API_KEY=
CUSTOM_LLM_BASE_URL=

# ==============================================================================
# Image Generation (Qwen Image 3.0 & Standby Personal Photo)
# ==============================================================================
ENABLE_IMAGE_GENERATION=true
STANDBY_PHOTO_PATH=data/standby/personal_photo.jpg
QWEN_IMAGE_MODEL=qwen-image-3.0

# ==============================================================================
# Cloudinary CDN Media Storage (Permanent Image Hosting for Buffer)
# Get credentials: https://console.cloudinary.com/
# ==============================================================================
# Option 1: Full URL (from Cloudinary Dashboard -> API Keys -> API Environment variable)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Option 2: Individual credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Pipeline & Safety Settings
# ==============================================================================
# Dry run mode: set to "true" to generate content locally without sending draft to Buffer
DRY_RUN=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

